{
  "name": "vitemple-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node node_modules/vitemple/scripts/preview.mjs",
    "dev": "node node_modules/vitemple/scripts/dev.mjs",
    "build": "vitemple src/index.html --outdir dist",
    "prebuild": "node scripts/copy-file-pack.mjs",
    "predev": "node scripts/copy-file-pack.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/check.mjs"
  },
  "dependencies": {
    "vitemple": "^0.2.3"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vite": "^6.4.3"
  }
}
