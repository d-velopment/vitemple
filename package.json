{
  "name": "temple",
  "version": "0.1.0",
  "type": "module",
  "description": "A small TypeScript-first component compiler targeting native DOM APIs",
  "main": "dist/compiler.js",
  "types": "dist/compiler.d.ts",
  "bin": { "temple": "dist/cli.js" },
  "files": ["dist", "dev.mjs", "tsconfig.json", "src/components.d.ts", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "example": "npm run build && node dist/cli.js ../temple-example/basic/src/index.html --outdir ../temple-example/basic/dist",
    "example:watch": "node scripts/watch-example.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "dev": "npm run build && vite",
    "preview": "python3 -m http.server 4173 --directory ../temple-example/basic/dist"
  },
  "dependencies": {
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "jsdom": "^26.0.0"
  }
}
