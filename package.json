{
  "name": "vitemple",
  "version": "0.1.6",
  "type": "module",
  "description": "A small TypeScript-first component compiler targeting native DOM APIs",
  "main": "dist/compiler.js",
  "types": "dist/compiler.d.ts",
  "bin": {
    "vitemple": "dist/cli.js"
  },
  "files": [
    "dist",
    "dev.mjs",
    "tsconfig.json",
    "src/components.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "example": "npm run build && node dist/cli.js ../vitemple-example/basic/src/index.html --outdir ../vitemple-example/basic/dist",
    "example:watch": "node scripts/watch-example.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "dev": "npm run build && vite",
    "preview": "python3 -m http.server 4173 --directory ../vitemple-example/basic/dist"
  },
  "dependencies": {
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "jsdom": "^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d-velopment/vitemple.git"
  },
  "homepage": "https://d-velopment.github.io/vitemple/"
}
