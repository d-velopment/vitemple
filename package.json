{
  "name": "vitemple",
  "version": "0.2.7",
  "type": "module",
  "description": "Vitemple lets you build static reactive multi-page sites with TypeScript-based HTML files, reusable components and native browser APIs.",
  "main": "dist/compiler.js",
  "types": "types/index.d.ts",
  "bin": {
    "vitemple": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/dev.mjs",
    "types/index.d.ts",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "src/components.d.ts",
    "scripts/preview.mjs",
    "scripts/postinstall.mjs",
    "favicon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "npx tsc && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "dev:project": "node scripts/watch-project.mjs",
    "dev:docs": "node scripts/watch-project.mjs ./docs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "jsdom": "^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d-velopment/vitemple.git"
  },
  "homepage": "https://d-velopment.github.io/vitemple/",
  "keywords": [
    "vitemple",
    "vite",
    "native-dom",
    "typescript",
    "templating",
    "framework",
    "static-site",
    "reactive",
    "template"
  ]
}
